# ── Supabase (Project Settings → API) ────────────────────────────
# Publishable values are safe for the browser; the secret key is SERVER ONLY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── AI provider (optional server-side default) ───────────────────
# Users normally configure providers in Settings → AI (stored encrypted).
# These env vars act as a fallback when no user-level provider is active.
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── AI provider key encryption (REQUIRED for Settings → AI) ──────
# Any long random string. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ── PDF engine service (engine-service/main.py) ──────────────────
ENGINE_URL=http://127.0.0.1:8000
ENGINE_API_KEY=
