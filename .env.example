# ==============================================================================
# EDITOR — Environment Variables (.env.example)
# ==============================================================================
# DO NOT COMMIT REAL CREDENTIALS. Copy to editor/.env.local and engine-service/.env

# ── Supabase Configuration ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# ── AI Provider Configuration (Default server-side fallback) ─────────────────
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o

# ── AI Key Encryption Secret (Required for storing custom user AI keys) ───────
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=your-random-32-byte-encryption-secret

# ── PDF Engine Microservice ──────────────────────────────────────────────────
ENGINE_URL=http://127.0.0.1:8000
ENGINE_API_KEY=your-shared-internal-engine-key
